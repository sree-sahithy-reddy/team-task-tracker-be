{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/generated"]
}
